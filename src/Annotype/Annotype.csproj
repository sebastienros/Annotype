<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Title>Annotype</Title>
    <Description>Move invariants from instances to types. Compile-time enforced, reflection-free type metadata for .NET: interfaces declare required attributes, an analyzer enforces them, and a source generator emits a registry to read them back without reflection.</Description>
    <PackageTags>attributes;metadata;analyzer;source-generator;roslyn;plugins;aot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Annotype.Runtime.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- The analyzer and generator ship inside this package under analyzers/dotnet/cs so that a single
       PackageReference brings both the runtime API and the compile-time tooling. -->
  <ItemGroup>
    <!-- No SetTargetFramework: the tooling is single-targeted, so this reference resolves to the same project
         instance as the solution build. Extra global properties would compile it twice in parallel, which fails
         on Windows with CS2012 (file in use). -->
    <ProjectReference Include="../Annotype.Tooling/Annotype.Tooling.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="AddAnnotypeToolingToPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../Annotype.Tooling/Annotype.Tooling.csproj" Targets="GetTargetPath" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_AnnotypeToolingAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_AnnotypeToolingAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
